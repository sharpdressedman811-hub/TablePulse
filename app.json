{
  "expo": {
    "name": "TablePulse",
    "slug": "tablepulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-iyn.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon-iyn.png",
      "resizeMode": "contain",
      "backgroundColor": "#000032"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tablepulse.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "TablePulse uses your camera to capture photos for your restaurant profile and analytics reports.",
        "NSPhotoLibraryUsageDescription": "TablePulse accesses your photo library so you can upload images for your restaurant profile and reports."
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.tablepulse.app.onesignal"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-iyn.png",
        "backgroundColor": "#000032"
      },
      "package": "com.tablepulse.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "tablepulse",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "oneSignalAppId": "b0daf7ae-e43e-4d83-b599-2431872f590a",
      "projectId": ""
    }
  }
}